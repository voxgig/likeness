{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "../dist/src",
    "rootDir": ".",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "composite": true
  },
  "include": [
    "**/*.ts"
  ]
}