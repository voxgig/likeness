primary: unit: {
  # ---------------------------------------------------------------- envelope
  envelope: set: [
    {
      id: "envelope/keys-sorted"
      fn: "serialise"
      in: { b:1 a:2 C:3 "10":4 "2":5 }
      # By Unicode code point, so digits precede uppercase which precedes
      # lowercase, and "10" precedes "2" because '0' < '2'.
      out: "{\"10\":4,\"2\":5,\"C\":3,\"a\":2,\"b\":1}\n"
    }

    {
      id: "envelope/keys-sorted-nested"
      fn: "serialise"
      in: { z: { y:1 x:2 } a: [{ n:1 m:2 }] }
      out: "{\"a\":[{\"m\":2,\"n\":1}],\"z\":{\"x\":2,\"y\":1}}\n"
    }

    { id:"envelope/trailing-newline-exactly-one" fn:"serialise" in:1 out:"1\n" }

    {
      id: "envelope/empty-containers-are-emitted"
      fn: "serialise"
      # Unification drops optional keys holding empty containers; serialisation
      # must not. An absent list and an empty one are different answers.
      in: { list: [] map: {} }
      out: "{\"list\":[],\"map\":{}}\n"
    }

    {
      id: "envelope/null-is-emitted"
      fn: "serialise"
      in: { a:null b:1 }
      out: "{\"a\":null,\"b\":1}\n"
    }

    {
      id: "envelope/absent-is-absent"
      fn: "serialise"
      # The same value with the key omitted. Null and missing mean different
      # things and must not be normalised into each other.
      in: b: 1
      out: "{\"b\":1}\n"
    }

    {
      id: "envelope/float-is-refused"
      fn: "serialise"
      in: ms: 1.5
      err: "floating point"
    }

    {
      id: "envelope/integer-is-exact"
      fn: "serialise"
      in: n: 9007199254740991
      out: "{\"n\":9007199254740991}\n"
    }

    {
      id: "envelope/integer-beyond-a-double-is-refused"
      # The canonical port parses numbers as doubles, so every port is held to
      # the integers a double names exactly.
      fn: "serialise"
      in: n: 9007199254740992
      err: "integer beyond exact double precision"
    }

    {
      id: "envelope/escape-quote-and-backslash"
      fn: "serialise"
      in: s: "a\"b\\c"
      out: "{\"s\":\"a\\\"b\\\\c\"}\n"
    }

    {
      id: "envelope/escape-control-as-lowercase-hex"
      fn: "serialise"
      # No \n or \t shorthand: one form for every control character removes a
      # class of per-port disagreement.
      in: s: "a\nb\tc"
      out: "{\"s\":\"a\\u000ab\\u0009c\"}\n"
    }

    {
      id: "envelope/non-ascii-is-literal-utf8"
      fn: "serialise"
      # JavaScript emits literal non-ASCII, several C JSON writers escape
      # everything. This picks one.
      in: s: "café 日本語"
      out: "{\"s\":\"café 日本語\"}\n"
    }

    {
      id: "envelope/raw-payload-is-an-opaque-string"
      fn: "serialise"
      # The one value likeness does not own. Nesting it unchanged would smuggle
      # a source's float formatting into the envelope, which is the exact
      # divergence these rules exist to prevent.
      in: raw: "{\"score\":0.5,\"b\":1,\"a\":2}"
      out: "{\"raw\":\"{\\\"score\\\":0.5,\\\"b\\\":1,\\\"a\\\":2}\"}\n"
    }

    {
      id: "envelope/partial-codes-are-a-closed-set"
      fn: "partialCodes"
      in: null
      out: ["budget-exceeded" "fanout-halted"]
    }
  ]

  # ---------------------------------------------------------------- selector
  selector: set: [
    {
      id: "selector/field-colon-value"
      fn: "parseSelector"
      in: "tag:launch"
      out: { t:"cmp" field:"tag" op:":" value: { k:"word" v:"launch" } }
    }

    {
      id: "selector/adjacency-implies-and"
      fn: "parseSelector"
      in: "tag:a tag:b"
      out: {
        t: "and"
        kids: [
          { t:"cmp" field:"tag" op:":" value: { k:"word" v:"a" } }
          { t:"cmp" field:"tag" op:":" value: { k:"word" v:"b" } }
        ]
      }
    }

    {
      id: "selector/or-binds-looser-than-and"
      fn: "parseSelector"
      in: "tag:a AND tag:b OR tag:c"
      out: {
        t: "or"
        kids: [
          {
            t: "and"
            kids: [
              { t:"cmp" field:"tag" op:":" value: { k:"word" v:"a" } }
              { t:"cmp" field:"tag" op:":" value: { k:"word" v:"b" } }
            ]
          }
          { t:"cmp" field:"tag" op:":" value: { k:"word" v:"c" } }
        ]
      }
    }

    {
      id: "selector/parens-override-precedence"
      fn: "parseSelector"
      in: "tag:a AND (tag:b OR tag:c)"
      out: {
        t: "and"
        kids: [
          { t:"cmp" field:"tag" op:":" value: { k:"word" v:"a" } }
          {
            t: "or"
            kids: [
              { t:"cmp" field:"tag" op:":" value: { k:"word" v:"b" } }
              { t:"cmp" field:"tag" op:":" value: { k:"word" v:"c" } }
            ]
          }
        ]
      }
    }

    {
      id: "selector/not-keyword"
      fn: "parseSelector"
      in: "NOT status:done"
      out: {
        t: "not"
        kid: { t:"cmp" field:"status" op:":" value: { k:"word" v:"done" } }
      }
    }

    {
      id: "selector/dash-negates-when-it-opens-an-atom"
      fn: "parseSelector"
      in: "-tag:draft"
      out: {
        t: "not"
        kid: { t:"cmp" field:"tag" op:":" value: { k:"word" v:"draft" } }
      }
    }

    {
      id: "selector/dash-inside-a-word-is-not-negation"
      fn: "parseSelector"
      in: "tag:rate-limit"
      out: { t:"cmp" field:"tag" op:":" value: { k:"word" v:"rate-limit" } }
    }

    {
      id: "selector/dash-after-a-term-negates"
      # A `-` that follows whitespace opens a new atom, wherever it stands.
      fn: "parseSelector"
      in: "title:a -title:b"
      out: {
        t: "and"
        kids: [
          { t:"cmp" field:"title" op:":" value: { k:"word" v:"a" } }
          {
            t: "not"
            kid: { t:"cmp" field:"title" op:":" value: { k:"word" v:"b" } }
          }
        ]
      }
    }

    {
      id: "selector/dash-before-a-term-negates"
      fn: "parseSelector"
      in: "-title:b title:a"
      out: {
        t: "and"
        kids: [
          {
            t: "not"
            kid: { t:"cmp" field:"title" op:":" value: { k:"word" v:"b" } }
          }
          { t:"cmp" field:"title" op:":" value: { k:"word" v:"a" } }
        ]
      }
    }

    {
      id: "selector/dash-after-a-word-negates"
      fn: "parseSelector"
      in: "retention -draft"
      out: {
        t: "and"
        kids: [
          { t:"text" v:"retention" }
          { t:"not" kid: { t:"text" v:"draft" } }
        ]
      }
    }

    {
      id: "selector/duration"
      fn: "parseSelector"
      in: "updated>14d"
      out: { t:"cmp" field:"updated" op:">" value: { k:"dur" n:14 unit:"d" } }
    }

    {
      id: "selector/duration-eight-digits-is-the-most"
      fn: "parseSelector"
      in: "updated>99999999d"
      out: {
        t: "cmp"
        field: "updated"
        op: ">"
        value: { k:"dur" n:99999999 unit:"d" }
      }
    }

    {
      id: "selector/duration-months-are-two-letters"
      fn: "parseSelector"
      in: "created<3mo"
      out: { t:"cmp" field:"created" op:"<" value: { k:"dur" n:3 unit:"mo" } }
    }

    {
      id: "selector/date"
      fn: "parseSelector"
      in: "updated>=2026-09-01"
      out: {
        t: "cmp"
        field: "updated"
        op: ">="
        value: { k:"date" v:"2026-09-01" }
      }
    }

    {
      id: "selector/symbolic-date"
      fn: "parseSelector"
      in: "updated>today"
      out: { t:"cmp" field:"updated" op:">" value: { k:"date" v:"today" } }
    }

    {
      id: "selector/quoted-value-is-never-reinterpreted"
      fn: "parseSelector"
      # The escape hatch: quoted, a date-shaped string is text.
      in: "title:\"2026-09-01\""
      out: { t:"cmp" field:"title" op:":" value: { k:"word" v:"2026-09-01" } }
    }

    {
      id: "selector/quoted-value-with-spaces"
      fn: "parseSelector"
      in: "title:\"retention policy\""
      out: {
        t: "cmp"
        field: "title"
        op: ":"
        value: { k:"word" v:"retention policy" }
      }
    }

    {
      id: "selector/quoted-escape"
      fn: "parseSelector"
      in: "title:\"a \\\"b\\\" c\""
      out: { t:"cmp" field:"title" op:":" value: { k:"word" v:"a \"b\" c" } }
    }

    {
      id: "selector/bareword-is-full-text"
      fn: "parseSelector"
      in: "retention"
      out: { t:"text" v:"retention" }
    }

    {
      id: "selector/not-equals"
      fn: "parseSelector"
      in: "status!=done"
      out: { t:"cmp" field:"status" op:"!=" value: { k:"word" v:"done" } }
    }

    {
      id: "selector/leap-day-accepted"
      # 2024 is a leap year, so the 29th of February exists and is accepted.
      fn: "parseSelector"
      in: "updated>2024-02-29"
      out: { t:"cmp" field:"updated" op:">" value: { k:"date" v:"2024-02-29" } }
    }

    {
      id: "selector/century-leap-day-accepted"
      # 2000 IS a leap year - divisible by 400 - where 1900 and 2100 are not.
      # A port testing only `y % 4` passes this one and fails the 2100 case
      # below, which is the whole reason both are here.
      fn: "parseSelector"
      in: "updated>2000-02-29"
      out: { t:"cmp" field:"updated" op:">" value: { k:"date" v:"2000-02-29" } }
    }
  ]

  # Malformed input. EVERY ONE ASSERTS A BYTE OFFSET: never a stack trace,
  # never silently ignored, and never a character index - the ports do not
  # agree on what a character is.
  selector-errors: set: [
    {
      id: "selector-err/empty"
      fn: "parseSelectorError"
      in: ""
      out: { offset:0 token:"" }
    }
    {
      id: "selector-err/unknown-field"
      fn: "parseSelectorError"
      in: "bogus:x"
      out: { offset:0 token:"bogus" }
    }
    {
      id: "selector-err/no-value"
      fn: "parseSelectorError"
      in: "tag:"
      out: { offset:4 token:"" }
    }
    {
      id: "selector-err/unterminated-quote"
      fn: "parseSelectorError"
      in: "tag:\"unterminated"
      out: { offset:4 token:"\"unterminated" }
    }
    {
      id: "selector-err/unclosed-group"
      fn: "parseSelectorError"
      in: "(tag:a"
      out: { offset:6 token:"" }
    }
    {
      id: "selector-err/unmatched-close"
      fn: "parseSelectorError"
      in: "tag:a)"
      out: { offset:5 token:")" }
    }
    {
      id: "selector-err/op-with-no-field"
      fn: "parseSelectorError"
      in: ":x"
      out: { offset:0 token:":" }
    }
    {
      id: "selector-err/malformed-duration"
      fn: "parseSelectorError"
      in: "updated>soon"
      out: { offset:8 token:"soon" }
    }
    {
      id: "selector-err/dangling-and"
      fn: "parseSelectorError"
      in: "tag:a AND"
      out: { offset:9 token:"" }
    }
    {
      id: "selector-err/dangling-or"
      fn: "parseSelectorError"
      in: "tag:a OR"
      out: { offset:8 token:"" }
    }
    {
      id: "selector-err/dangling-not"
      fn: "parseSelectorError"
      in: "NOT"
      out: { offset:3 token:"" }
    }
    {
      id: "selector-err/bare-bang"
      fn: "parseSelectorError"
      in: "tag:a !b"
      out: { offset:6 token:"!" }
    }

    # THE OFFSET IS BYTES, NOT CHARACTERS, and these two prove it: the
    # offending token starts at character 11 and character 10 respectively.
    {
      id: "selector-err/offset-is-bytes-latin1"
      fn: "parseSelectorError"
      in: "title:café bogus:x"
      out: { offset:12 token:"bogus" }
    }
    {
      id: "selector-err/impossible-day"
      fn: "parseSelectorError"
      in: "updated>2026-02-31"
      out: { offset:8 token:"2026-02-31" }
    }

    {
      id: "selector-err/non-leap-february"
      fn: "parseSelectorError"
      in: "updated>2026-02-29"
      out: { offset:8 token:"2026-02-29" }
    }

    {
      id: "selector-err/century-is-not-a-leap-year"
      fn: "parseSelectorError"
      in: "updated>2100-02-29"
      out: { offset:8 token:"2100-02-29" }
    }

    {
      id: "selector-err/short-month"
      fn: "parseSelectorError"
      in: "updated>2026-04-31"
      out: { offset:8 token:"2026-04-31" }
    }

    {
      id: "selector-err/offset-is-bytes-cjk"
      fn: "parseSelectorError"
      in: "title:日本語 bogus:x"
      out: { offset:16 token:"bogus" }
    }

    {
      id: "selector-err/duration-overflow"
      fn: "parseSelectorError"
      in: "updated>99999999999999999999d"
      out: { offset:8 token:"99999999999999999999d" }
    }

    {
      id: "selector-err/duration-nine-digits"
      fn: "parseSelectorError"
      in: "updated>123456789d"
      out: { offset:8 token:"123456789d" }
    }

    {
      id: "selector-err/ordering-on-a-text-field"
      # `>` and friends compare dates, which only created and updated hold.
      fn: "parseSelectorError"
      in: "title>2026-01-01"
      out: { offset:5 token:">" }
    }

    {
      id: "selector-err/ordering-on-body-with-a-duration"
      fn: "parseSelectorError"
      in: "body<3d"
      out: { offset:4 token:"<" }
    }
  ]

  # ---------------------------------------------------------------- identity
  text: set: [
    {
      id: "text/case-folding-is-ascii-only"
      # A-Z fold to a-z and nothing else does, so every port agrees on it.
      fn: "foldCase"
      in: "İSTANBUL Straße ΟΔΟΣ ÀÉ ABC xyz"
      out: "İstanbul straße ΟΔΟΣ ÀÉ abc xyz"
    }
  ]

  project: set: [
    {
      id: "project/no-id-is-refused"
      # Every such row would share one identity, so the record is refused.
      fn: "projectJoplin"
      in: { instance:"jot" account:"local" raw:title:"no id" }
      err: "record with no id"
    }

    {
      id: "project/null-and-non-string-values"
      fn: "projectJoplin"
      in: {
        instance: "jot"
        account: "local"
        raw: {
          id: "n1"
          title: null
          body: 42
          parent_id: 7
          created_time: "nope"
          updated_time: 1773129600000
        }
      }
      out: {
        lid: "lk_xjb81w96kpdh"
        source: "joplin"
        instance: "jot"
        id: "n1"
        title: ""
        body: "42"
        space: "7"
        url: "joplin://x-callback-url/openNote?id=n1"
        created: "1970-01-01T00:00:00Z"
        updated: "2026-03-10T08:00:00Z"
      }
    }

    {
      id: "project/small-numbers-as-javascript-writes-them"
      # Plain digits from 1e-6, the exponent form below it.
      fn: "projectJoplin"
      in: {
        instance: "jot"
        account: "local"
        raw: {
          id: "n2"
          title: 0.00000015
          body: 0.000001
          parent_id: 0.0000001
          created_time: 0
          updated_time: 0
        }
      }
      out: {
        lid: "lk_18xfpffw3qe4"
        source: "joplin"
        instance: "jot"
        id: "n2"
        title: "1.5e-7"
        body: "0.000001"
        space: "1e-7"
        url: "joplin://x-callback-url/openNote?id=n2"
        created: "1970-01-01T00:00:00Z"
        updated: "1970-01-01T00:00:00Z"
      }
    }
  ]

  args: set: [
    {
      id: "args/flags-anywhere-after-the-command"
      fn: "parseArgv"
      in: ["list" "--limit" "2" "--json"]
      out: { command:"list" flags: { limit:2 json:true } args: [] }
    }

    {
      id: "args/equals-form"
      fn: "parseArgv"
      in: ["list" "--limit=2"]
      out: { command:"list" flags:limit:2 args: [] }
    }

    {
      id: "args/selector-terms-accumulate"
      fn: "parseArgv"
      in: ["list" "title:a" "--json" "tag:b"]
      out: { command:"list" flags:json:true args: ["title:a" "tag:b"] }
    }

    {
      id: "args/double-dash-ends-flags"
      fn: "parseArgv"
      in: ["list" "--json" "--" "-title:x" "--raw"]
      out: { command:"list" flags:json:true args: ["-title:x" "--raw"] }
    }

    {
      id: "args/negated-boolean"
      fn: "parseArgv"
      in: ["list" "--no-raw"]
      out: { command:"list" flags:raw:false args: [] }
    }

    {
      id: "args/repeatable-accumulates-in-order"
      fn: "parseArgv"
      in: ["list" "--instance" "joplin$spare" "--instance" "joplin"]
      out: { command:"list" flags:instance: ["joplin$spare" "joplin"] args: [] }
    }

    {
      id: "args/help-flag-first-is-help"
      fn: "parseArgv"
      in: ["--help"]
      out: { command:"help" flags: {} args: [] }
    }

    {
      id: "args/short-help-takes-a-command"
      fn: "parseArgv"
      in: ["-h" "list"]
      out: { command:"help" flags: {} args: ["list"] }
    }

    {
      id: "args/version-flag-first-is-version"
      fn: "parseArgv"
      in: ["--version" "--json"]
      out: { command:"version" flags:json:true args: [] }
    }

    {
      id: "args/a-command-being-built-reads-its-globals"
      fn: "parseArgv"
      in: ["search" "anything" "--bogus" "-x" "--json"]
      out: { command:"search" flags:json:true args: [] }
    }

    {
      id: "args/refs-accumulate"
      fn: "parseArgv"
      in: ["get" "joplin:a" "joplin:b"]
      out: { command:"get" flags: {} args: ["joplin:a" "joplin:b"] }
    }

    {
      id: "args/stdin-dash-is-a-positional"
      fn: "parseArgv"
      in: ["list" "-"]
      out: { command:"list" flags: {} args: ["-"] }
    }

    { id:"args/no-command" fn:"parseArgv" in: [] err:"no command given" }

    {
      id: "args/flag-before-the-command"
      fn: "parseArgv"
      in: ["--json" "list"]
      err: "the command comes first, and --json is a flag"
    }

    {
      id: "args/unknown-command"
      fn: "parseArgv"
      in: ["nosuch"]
      err: "no such command: nosuch"
    }

    {
      id: "args/undeclared-flag"
      fn: "parseArgv"
      in: ["list" "--bogus"]
      err: "`list` has no flag --bogus"
    }

    {
      id: "args/prototype-name-is-not-a-flag"
      fn: "parseArgv"
      in: ["list" "--constructor"]
      err: "`list` has no flag --constructor"
    }

    {
      id: "args/negating-a-valued-flag"
      fn: "parseArgv"
      in: ["list" "--no-limit"]
      err: "`list` has no flag --no-limit"
    }

    {
      id: "args/dash-positional-must-follow-double-dash"
      fn: "parseArgv"
      in: ["list" "-title:x"]
      err: "-title:x begins with - and is not a flag; a positional that begins with - must follow --"
    }

    {
      id: "args/boolean-takes-no-value"
      fn: "parseArgv"
      in: ["list" "--raw=yes"]
      err: "--raw takes no value"
    }

    {
      id: "args/value-missing-at-the-end"
      fn: "parseArgv"
      in: ["list" "--limit"]
      err: "--limit needs a value"
    }

    {
      id: "args/value-missing-before-a-flag"
      fn: "parseArgv"
      in: ["list" "--limit" "--json"]
      err: "--limit needs a value"
    }

    {
      id: "args/integer-not-coerced-decimal"
      fn: "parseArgv"
      in: ["list" "--limit" "2.0"]
      err: "--limit takes an integer from 1 to 999999999, not \"2.0\""
    }

    {
      id: "args/integer-not-coerced-hex"
      fn: "parseArgv"
      in: ["list" "--limit=0x2"]
      err: "--limit takes an integer from 1 to 999999999, not \"0x2\""
    }

    {
      id: "args/integer-below-the-range"
      fn: "parseArgv"
      in: ["list" "--limit" "0"]
      err: "--limit takes an integer from 1 to 999999999, not \"0\""
    }

    {
      id: "args/integer-above-the-range"
      fn: "parseArgv"
      in: ["list" "--limit" "1000000000"]
      err: "not \"1000000000\""
    }

    {
      id: "args/integer-beyond-any-host-number"
      fn: "parseArgv"
      in: ["list" "--limit" "99999999999999999999"]
      err: "not \"99999999999999999999\""
    }

    {
      id: "args/given-twice"
      fn: "parseArgv"
      in: ["list" "--limit" "2" "--limit" "3"]
      err: "--limit was given twice"
    }

    {
      id: "args/boolean-given-twice"
      fn: "parseArgv"
      in: ["list" "--json" "--no-json"]
      err: "--json was given twice"
    }

    {
      id: "args/instance-is-a-ref"
      fn: "parseArgv"
      in: ["list" "--instance" "Joplin"]
      err: "--instance takes an instance ref (api or api$tag), not \"Joplin\""
    }

    {
      id: "args/name-is-lowercase"
      fn: "parseArgv"
      in: ["list" "--sort" "Title"]
      err: "--sort takes a name ([a-z][a-z0-9-]*), not \"Title\""
    }

    {
      id: "args/empty-path"
      fn: "parseArgv"
      in: ["list" "--config="]
      err: "--config takes a path, not \"\""
    }

    {
      id: "args/required-positional-missing"
      fn: "parseArgv"
      in: ["get" "--json"]
      err: "`get` needs <ref>"
    }

    {
      id: "args/surplus-positional"
      fn: "parseArgv"
      in: ["version" "extra"]
      err: "`version` does not take the argument \"extra\""
    }

    {
      id: "args/help-takes-the-words-of-a-command"
      # An action is a group's second word, so help reads every word; words that
      # name no command are refused when help looks them up.
      fn: "parseArgv"
      in: ["help" "secrets" "set"]
      out: { command:"help" flags: {} args: ["secrets" "set"] }
    }

    {
      id: "args/help-command-is-a-name"
      fn: "parseArgv"
      in: ["help" "LIST"]
      err: "<command> takes a name ([a-z][a-z0-9-]*), not \"LIST\""
    }
  ]

  config: set: [
    {
      id: "config/equals-form"
      # `--config=PATH` and `--config PATH` are one flag; a port read only the second.
      fn: "takeConfigOption"
      in: ["list" "--config=/x/station.json" "--json"]
      out: { rest: ["list" "--json"] value:"/x/station.json" }
    }

    {
      id: "config/space-form"
      fn: "takeConfigOption"
      in: ["list" "--config" "/y" "--json"]
      out: { rest: ["list" "--json"] value:"/y" }
    }

    { id:"config/absent" fn:"takeConfigOption" in: ["list"] out:rest: ["list"] }

    {
      id: "config/before-the-command-is-left"
      fn: "takeConfigOption"
      in: ["--config" "/x" "list"]
      out: rest: ["--config" "/x" "list"]
    }

    {
      id: "config/after-double-dash-is-left"
      fn: "takeConfigOption"
      in: ["list" "--" "--config" "/x"]
      out: rest: ["list" "--" "--config" "/x"]
    }

    {
      id: "config/twice-is-left-for-the-grammar"
      fn: "takeConfigOption"
      in: ["list" "--config" "/a" "--config=/b"]
      out: rest: ["list" "--config" "/a" "--config=/b"]
    }

    {
      id: "config/no-value-is-left"
      fn: "takeConfigOption"
      in: ["list" "--config"]
      out: rest: ["list" "--config"]
    }

    {
      id: "config/flag-shaped-value-is-left"
      fn: "takeConfigOption"
      in: ["list" "--config" "--json"]
      out: rest: ["list" "--config" "--json"]
    }

    {
      id: "config/station-not-json"
      fn: "connections"
      in: { station:"{not json" likeness:"{}" }
      err: "station.json is not valid JSON"
    }

    {
      id: "config/station-shape-invalid"
      # Station validates the file against its own shape, in every port.
      fn: "connections"
      in: { station:"{\"station\":2}" likeness:"{}" }
      err: "station.json: station_config_invalid"
    }

    {
      id: "config/station-not-an-object"
      fn: "connections"
      in: { station:"[]" likeness:"{}" }
      err: "station.json is not a JSON object"
    }

    {
      id: "config/station-refused-for-a-shared-secret"
      # Any refusal of station's own, not only a shape mismatch, is the file's.
      fn: "connections"
      in: {
        station: "{\"station\":1,\"profiles\":{\"default\":{\"sdk\":{\"notes-a\":{},\"notes$a\":{}}}}}"
        likeness: "{}"
      }
      err: "station.json: station_secret_collision"
    }

    {
      id: "config/likeness-not-an-object"
      fn: "connections"
      in: {
        station: "{\"station\":1,\"profiles\":{\"default\":{\"sdk\":{\"joplin\":{}}}}}"
        likeness: "1"
      }
      err: "likeness.json is not a JSON object"
    }

    {
      id: "config/likeness-not-json"
      fn: "connections"
      in: {
        station: "{\"station\":1,\"profiles\":{\"default\":{\"sdk\":{\"joplin\":{}}}}}"
        likeness: "{not json"
      }
      err: "likeness.json is not valid JSON"
    }

    {
      id: "config/connections-in-name-order"
      # Station's declared instances, in code-point order of the ref: `$` sorts
      # before every letter, so a tagged instance follows its untagged api.
      fn: "connections"
      in: {
        station: "{\"station\":1,\"profiles\":{\"default\":{\"sdk\":{\"joplin$zed\":{},\"joplin\":{},\"joplin$abe\":{\"base\":\"http://x\"}}}}}"
        likeness: "{\"likeness\":1,\"profiles\":{\"default\":{\"instances\":{\"joplin$zed\":{\"account\":\"z\"},\"joplin\":{\"account\":\"local\"},\"joplin$abe\":{\"account\":\"a\"}}}}}"
      }
      out: [
        { instance:"joplin" source:"joplin" account:"local" }
        { instance:"joplin$abe" source:"joplin" account:"a" }
        { instance:"joplin$zed" source:"joplin" account:"z" }
      ]
    }

    {
      id: "config/inactive-instance-omitted"
      fn: "connections"
      in: {
        station: "{\"station\":1,\"profiles\":{\"default\":{\"sdk\":{\"joplin\":{\"active\":false},\"joplin$on\":{}}}}}"
        likeness: "{\"likeness\":1,\"profiles\":{\"default\":{\"instances\":{\"joplin$on\":{\"account\":\"on\"}}}}}"
      }
      out: [{ instance:"joplin$on" source:"joplin" account:"on" }]
    }

    {
      id: "config/instance-without-account"
      # Identity may not be derived from the instance ref.
      fn: "connections"
      in: {
        station: "{\"station\":1,\"profiles\":{\"default\":{\"sdk\":{\"joplin\":{}}}}}"
        likeness: "{\"likeness\":1,\"profiles\":{\"default\":{\"instances\":{}}}}"
      }
      err: "instance \"joplin\" has no account in likeness.json under profile \"default\""
    }

    {
      id: "config/account-follows-the-profile"
      # Profiles declaring one ref against different applications: each
      # profile's notes take their identity from its own account.
      fn: "connections"
      in: {
        station: "{\"station\":1,\"profiles\":{\"default\":{\"sdk\":{\"joplin\":{}}},\"work\":{\"sdk\":{\"joplin\":{\"base\":\"http://127.0.0.1:41185\"}}}}}"
        likeness: "{\"likeness\":1,\"profiles\":{\"default\":{\"instances\":{\"joplin\":{\"account\":\"home\"}}},\"work\":{\"instances\":{\"joplin\":{\"account\":\"office\"}}}}}"
        profile: "work"
      }
      out: [{ instance:"joplin" source:"joplin" account:"office" }]
    }

    {
      id: "config/profile-inherits-no-account"
      # Station's profile merge gives the profile its instance; the account is
      # not merged with it.
      fn: "connections"
      in: {
        station: "{\"station\":1,\"profiles\":{\"default\":{\"sdk\":{\"joplin\":{}}},\"work\":{}}}"
        likeness: "{\"likeness\":1,\"profiles\":{\"default\":{\"instances\":{\"joplin\":{\"account\":\"home\"}}}}}"
        profile: "work"
      }
      err: "instance \"joplin\" has no account in likeness.json under profile \"work\""
    }
  ]

  # The vault station.json names, resolved for a home of /home/u and a
  # configuration directory of /home/u/.config/likeness.
  vault: set: [
    {
      id: "vault/default"
      # No chain named: the vault beside station.json, opened as master.
      fn: "vaultEntry"
      in: station: null
      out: {
        file: "/home/u/.config/likeness/likeness.skmv"
        key: "master"
        shown: "~/.config/likeness/likeness.skmv"
      }
    }

    {
      id: "vault/relative-to-the-configuration"
      fn: "vaultEntry"
      in: station: profiles: default: secrets: providers: [
        { kind:"minivault" file:"../team/v.skmv" }
      ]
      out: {
        file: "/home/u/.config/team/v.skmv"
        key: "master"
        shown: "~/.config/team/v.skmv"
      }
    }

    {
      id: "vault/from-home"
      fn: "vaultEntry"
      in: station: profiles: default: secrets: providers: [
        { kind:"minivault" file:"~/v.skmv" }
      ]
      out: { file:"/home/u/v.skmv" key:"master" shown:"~/v.skmv" }
    }

    {
      id: "vault/from-home-past-a-doubled-slash"
      fn: "vaultEntry"
      in: station: profiles: default: secrets: providers: [
        { kind:"minivault" file:"~//v.skmv" }
      ]
      out: { file:"/home/u/v.skmv" key:"master" shown:"~/v.skmv" }
    }

    {
      id: "vault/outside-home-is-shown-whole"
      fn: "vaultEntry"
      in: station: profiles: default: secrets: providers: [
        { kind:"minivault" file:"/srv/v.skmv" }
      ]
      out: { file:"/srv/v.skmv" key:"master" shown:"/srv/v.skmv" }
    }

    {
      id: "vault/vaultkey"
      fn: "vaultEntry"
      in: station: profiles: default: secrets: providers: [
        { kind:"minivault" vaultkey:"ci" }
      ]
      out: {
        file: "/home/u/.config/likeness/likeness.skmv"
        key: "ci"
        shown: "~/.config/likeness/likeness.skmv"
      }
    }

    {
      id: "vault/flag-over-vaultkey"
      fn: "vaultEntry"
      in: {
        station: profiles: default: secrets: providers: [
          { kind:"minivault" vaultkey:"ci" }
        ]
        key: "master"
      }
      out: {
        file: "/home/u/.config/likeness/likeness.skmv"
        key: "master"
        shown: "~/.config/likeness/likeness.skmv"
      }
    }

    {
      id: "vault/profile-chain-wins"
      # Chosen the way station chooses: the profile's chain, else default's.
      fn: "vaultEntry"
      in: {
        station: profiles: {
          default: secrets: providers: [{ kind:"minivault" file:"a.skmv" }]
          work: secrets: providers: [{ kind:"minivault" file:"b.skmv" }]
        }
        profile: "work"
      }
      out: {
        file: "/home/u/.config/likeness/b.skmv"
        key: "master"
        shown: "~/.config/likeness/b.skmv"
      }
    }

    {
      id: "vault/profile-without-a-chain"
      fn: "vaultEntry"
      in: {
        station: profiles: {
          default: secrets: providers: [{ kind:"minivault" file:"a.skmv" }]
          work: sdk: {}
        }
        profile: "work"
      }
      out: {
        file: "/home/u/.config/likeness/a.skmv"
        key: "master"
        shown: "~/.config/likeness/a.skmv"
      }
    }

    {
      id: "vault/env-store-refused"
      fn: "vaultEntry"
      in: station: profiles: default: secrets: providers: [kind:"env"]
      err: "likeness reads secrets from its vault alone, and station.json names the store \"env\""
    }

    {
      id: "vault/bare-kind-refused"
      fn: "vaultEntry"
      in: station: profiles: default: secrets: providers: ["minivault"]
      err: "names the store \"minivault\""
    }

    {
      id: "vault/empty-chain-refused"
      fn: "vaultEntry"
      in: station: profiles: default: secrets: providers: []
      err: "secrets.providers must name one store, the vault"
    }

    {
      id: "vault/null-chain-is-no-chain"
      fn: "vaultEntry"
      in: station: profiles: default: secrets: providers: null
      out: {
        file: "/home/u/.config/likeness/likeness.skmv"
        key: "master"
        shown: "~/.config/likeness/likeness.skmv"
      }
    }

    {
      id: "vault/entry-without-a-kind-refused"
      fn: "vaultEntry"
      in: station: profiles: default: secrets: providers: [file:"likeness.skmv"]
      err: "the vault entry in station.json does not name its kind"
    }

    {
      id: "vault/passphrase-refused"
      fn: "vaultEntry"
      in: station: profiles: default: secrets: providers: [
        { kind:"minivault" passphrase:"p" }
      ]
      err: "a passphrase is never written to a file"
    }

    {
      id: "vault/unknown-key-refused"
      fn: "vaultEntry"
      in: station: profiles: default: secrets: providers: [
        { kind:"minivault" iterations:1 }
      ]
      err: "the vault entry in station.json has no key \"iterations\""
    }

    {
      id: "vault/file-must-be-a-path"
      fn: "vaultEntry"
      in: station: profiles: default: secrets: providers: [
        { kind:"minivault" file:"" }
      ]
      err: "the vault entry's file is not a path"
    }

    {
      id: "vault/vaultkey-must-be-a-name"
      fn: "vaultEntry"
      in: station: profiles: default: secrets: providers: [
        { kind:"minivault" vaultkey:"Admin" }
      ]
      err: "the vault entry's vaultkey is not a key name"
    }
  ]

  identity: set: [
    # Known vectors. A port that gets this subtly wrong produces
    # plausible-looking identifiers that silently fail to match another port's,
    # which is the worst kind of wrong. Cross-checked against an independent
    # implementation before being written down.
    {
      id: "identity/lid-joplin"
      fn: "lid"
      in: ["joplin" "profile-1" "note" "a0e50000000000000000000000000001"]
      out: "lk_sptw25xyrt8t"
    }

    {
      id: "identity/lid-empty-id"
      fn: "lid"
      in: ["joplin" "profile-1" "note" ""]
      out: "lk_ha1dc206dj90"
    }

    {
      id: "identity/lid-linear"
      fn: "lid"
      in: ["linear" "voxgig" "note" "CORE-412"]
      out: "lk_wkp9w5jzyh71"
    }

    {
      id: "identity/lid-notion"
      fn: "lid"
      in: ["notion" "8f14e45f" "note" "9f2c1a7b"]
      out: "lk_e5h86f0xvf4q"
    }

    # The alphabet omits i, l, o and u. A lid may never contain one.
    {
      id: "identity/crockford-alphabet"
      fn: "crockfordAlphabet"
      in: null
      out: "0123456789abcdefghjkmnpqrstvwxyz"
    }

    { id:"identity/rfc3339-epoch" fn:"rfc3339" in:0 out:"1970-01-01T00:00:00Z" }
    {
      id: "identity/rfc3339-first-four-digit-year"
      fn: "rfc3339"
      in: -62167219200000
      out: "0000-01-01T00:00:00Z"
    }
    {
      id: "identity/rfc3339-last-four-digit-year"
      fn: "rfc3339"
      in: 253402300799999
      out: "9999-12-31T23:59:59Z"
    }
    {
      id: "identity/rfc3339-before-year-zero"
      # Refused rather than written another way: no year outside 0000-9999 has
      # an RFC 3339 form.
      fn: "rfc3339"
      in: -62167219200001
      err: "outside the years 0000 to 9999"
    }
    {
      id: "identity/rfc3339-after-year-9999"
      fn: "rfc3339"
      in: 253402300800000
      err: "outside the years 0000 to 9999"
    }
    {
      id: "identity/rfc3339-second-precision"
      # Milliseconds are truncated, never rounded: RFC 3339 UTC at second
      # precision is the only timestamp form the envelope carries.
      fn: "rfc3339"
      in: 1758008460999
      out: "2025-09-16T07:41:00Z"
    }
  ]

  # ------------------------------------------------------------------- order
  order: set: [
    {
      id: "order/code-point-not-utf16"
      fn: "compareCodePoints"
      in: ["𝐀" "�"]
      out: 1
    }

    {
      id: "order/shorter-prefix-first"
      fn: "compareCodePoints"
      in: ["ab" "abc"]
      out: -1
    }

    { id:"order/equal" fn:"compareCodePoints" in: ["abc" "abc"] out:0 }
  ]
}
