@"./base.aon"
@"./note.aon"

ReplicaDriver: type(close({
  driver: string

  dependency: boolean

  note: string

  fts5: boolean
}))

# How a row's freshness is judged. A cache that cannot say how old it is invites
# exactly the mistake this design is trying to avoid.
Freshness: type(close({ synced:$.Rfc3339 version?:string pending:boolean }))

Replica: type(close({
  repo: $.RepoRef
  semver: $.Semver
  rev: $.Sha

  # The entities the replica mirrors. A subset is legitimate - the replica is a
  # cache - but it must be declared, because a command that falls back to the
  # replica for an entity it does not hold would answer "nothing" rather than
  # "not cached".
  entity: [&: $.EntityKind]

  port: close({
    ts: $.ReplicaDriver
    go: $.ReplicaDriver
    py: $.ReplicaDriver
    rb: $.ReplicaDriver
    c: $.ReplicaDriver
  })

  rule: close({
    write_through: true
    disposable: true
    reads_are_marked: true
    opt_in: true
  })
}))

replica: $.Replica
