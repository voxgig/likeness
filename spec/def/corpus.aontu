@"./base.aontu"

Call: type(close({ instance:$.InstanceRef method:$.Method path:string }))

Net: type(close({
  offline?: boolean
  latency?: $.Millis
  failTimes?: $.Count
  # An HTTP status the transport should return instead of answering. Not
  # $.Exit, and not a free integer either: a status outside the response range
  # is a typo, not a test.
  failStatus?: integer & min(100) & max(599)
  errorTimes?: $.Count
}))

Conn: type(close({
  instance: $.InstanceRef
  account: string
  net?: $.Net
  block?: { &: top }
}))

VaultKey: type(close({
  key: string
  master: boolean
  write: boolean
  grants: [&: string]
}))

VaultState: type(close({
  file?: string
  key?: string
  passphrase: string
  names: [&: string]
  keys?: [&: $.VaultKey]
  values?: { &: string }
}))

Ctx: type(close({
  fixture: string

  # The connections this entry runs against, in order. An entry naming none is
  # legitimate - `version` and `which` never touch a source - so this is a list
  # that may be empty rather than an optional key, because "no connections" and
  # "connections unspecified" must not be spelled the same way.
  connections: [&: $.Conn]

  clock: $.Rfc3339

  seed: integer & min(0)

  env?: { &: string }

  path?: [&: close({ path:string port:string version:string })]

  files?: { &: string }

  secrets?: top

  stdin?: string

  tty?: [&: string]
}))

Out: type(close({
  exit: $.Exit
  stdout: string

  stderr?: string
  calls: [&: $.Call]

  prompts?: [&: string]
  vault?: $.VaultState
}))

CliEntry: type(close({
  id: string & re("^[a-z0-9/-]+$")
  args: [&: string]
  ctx: $.Ctx
  out: $.Out
}))

UnitEntry: type(
  close({
    id: string & re("^[a-z0-9/-]+$")
    fn: string & re("^[a-zA-Z][a-zA-Z0-9_.]*$")
    in: top
    out: top
  })
  | close({
    id: string & re("^[a-z0-9/-]+$")
    fn: string & re("^[a-zA-Z][a-zA-Z0-9_.]*$")
    in: top
    # The entry asserts a throw INSTEAD OF a value, so there is no `out` here.
    err: string
  })
)

primary: close({
  unit: { &: close({ set: [&: $.UnitEntry] }) }
  cli: { &: close({ set: [&: $.CliEntry] }) }
})
