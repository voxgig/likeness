@"./base.aon"

ProjectSource: type(close({
  # The connection name, as configured. Must be a connection that exists;
  # `project check` resolves it and refuses a name that does not.
  instance: $.Ident
  space?: string
}))

View: type(close({
  # A selector, in likeness's own grammar. Parsed and validated at check time,
  # so a malformed view fails before it is ever run.
  where: string
  sort: string
}))

Project: type(close({
  name: $.Ident

  source: { &: $.ProjectSource }

  same: [&: { &: $.SourceId }]

  # Field-level precedence when merged members disagree. Instance names, most
  # preferred first. Where precedence does not settle a field, the field
  # becomes a CONFLICT OBJECT listing every value - it is never resolved by
  # picking the first, because most conflicts are information.
  prefer: [&: $.Ident]

  alias?: { &: string }

  view: { &: $.View }
}))

project: $.Project
