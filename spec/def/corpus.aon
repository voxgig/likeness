# likeness: the parity corpus shapes.
#
# Two corpora, one mechanism. Both are written here, compiled to committed JSON,
# and run in-process by every port through its own library.
#
#   unit  - pure functions. Fast, precise, and where cross-language drift
#           actually starts.
#   cli   - whole commands. The contract that matters, because it is the CLI's
#           behaviour written down.
#
# The idea underneath both: A LIKENESS COMMAND IS A PURE FUNCTION.
#
#   (argv, env, config, fixture-state, clock) -> (exit, stdout, stderr, calls)
#
# Everything impure is a parameter. The clock is injected, the network is the
# SDK's own offline test transport, identifiers are seeded, and concurrency is
# unobservable because results are sorted. Given that, a whole command fits in
# a corpus entry.

@"./base.aon"

# One outbound call the command is expected to have attempted.
#
# ASSERTING CALLS IS THE POINT. An entry that checked only stdout would pass for
# a command that produced the right answer by making forty requests. It is also
# how "a no-op sync makes zero write calls" becomes a test rather than a hope.
Call: type(close({ instance:$.Ident method:$.Method path:string }))

# The context a transcript entry runs in. Every impure input, named.
Ctx: type(close({
  # The fixture set: a map of seed records handed to the SDK's offline test
  # mode, by source. Recorded once and frozen.
  fixture: string

  # Injected. Never the wall clock: an entry that asserted on `now` would pass
  # for one second and fail forever after.
  clock: $.Rfc3339

  # Seeds the identifier source. REQUIRED, and this is not a formality: the
  # SDKs' offline test mode mints a random identifier for a create that
  # supplies none, and the minted form differs between ports. An entry that
  # creates a record must supply the identifier explicitly.
  seed: integer & min(0)

  # Environment overrides, if any.
  env?: { &: string }
}))

# What the command must produce.
Out: type(close({
  exit: $.Exit
  # A path to a committed expectation file, byte-compared. Not parsed and
  # compared: key order, spacing, escaping and the trailing newline are all
  # part of the contract.
  stdout: string
  stderr?: string
  calls: [&: $.Call]
}))

# One whole-command entry.
CliEntry: type(close({
  id: string & re("^[a-z0-9/-]+$")
  args: [&: string]
  ctx: $.Ctx
  out: $.Out
}))

# One pure-function entry. `in` and `out` are unconstrained because the corpus
# covers functions of many signatures; the shape's job here is to make sure
# every entry is addressable, named and accounted for.
UnitEntry: type(close({
  id: string & re("^[a-z0-9/-]+$")
  # The canonical function under test, as the TypeScript port exports it.
  fn: string & re("^[a-zA-Z][a-zA-Z0-9_.]*$")
  in: top
  out: top
  # Set where the entry asserts a throw rather than a value.
  err?: string
}))

primary: close({
  unit: { &: close({ set: [&: $.UnitEntry] }) }
  cli: { &: close({ set: [&: $.CliEntry] }) }
})
