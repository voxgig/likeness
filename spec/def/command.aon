@"./base.aon"
@"./note.aon"

FlagType: hide("boolean"|"string"|"integer"|"path"|"selector"|"ref")

Flag: type(close({
  name: $.Ident
  type: $.FlagType
  short: string
  default?: string
  # A flag an agent may never set. The human-decision floors are refusals in
  # the code, and this marks the same ground in the data so the MCP tool
  # descriptions and `describe` cannot drift from them.
  human_only: boolean
}))

Command: type(close({
  name: $.Ident
  short: string

  op: $.OpKind|false

  writes: boolean

  # Whether it is exposed as a tool to an agent. Hard delete is absent from the
  # tool list AND refused on the command line in agent mode, because excluding
  # a tool does not cover the path where an agent simply types the command.
  agent: boolean

  arg: [&: close({ name:$.Ident type:$.FlagType required:boolean })]
  flag: { &: $.Flag }

  exits: [&: $.Exit]
}))

command: { &: $.Command }
