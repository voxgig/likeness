@"./base.aontu"

# A value is checked against its declared type and never coerced. A selector
# or ref is checked by its own parser, and keeps that parser's error code.
ArgType: hide("boolean"|"string"|"name"|"integer"|"path"|"selector"|"ref"|"instance"|"secret"|"stdin"|"envvar")

Flag: type(close({
  type: $.ArgType
  short: string
  # The value's placeholder in help: `N` in `--limit N`.
  value?: string
  repeat?: boolean
  min?: integer
  max?: integer
}))

Arg: type(close({
  name: $.Ident
  type: $.ArgType
  required: boolean
  # Only the last positional may repeat; it takes every remaining argument.
  repeat?: boolean
  short: string
}))

Command: type(close({
  short: string
  # A declared command whose behaviour has not landed reads only the global
  # flags, then answers unsupported-capability.
  ready: boolean
  writes: boolean
  # false: a refused argument is never repeated in the error, in case it is a
  # secret typed where its name belongs.
  echo?: boolean
  arg: [&: $.Arg]
  flag: { &: $.Flag }
  exits: [&: $.Code]
}))

global: { &: $.Flag }
command: { &: $.Command }
