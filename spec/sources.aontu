source: {
  joplin: {
    name: "joplin"
    repo: "voxgig-sdk/joplin-sdk"
    def: "joplin-notes-folders-tags.json"
    defkind: "openapi"
    semver: "0.0.1"
    rev: "89b86ca5df39d8d607091a12a59e988253545874"
    protocol: "http"
    local: false

    auth: { kind:"query" carrier:"token" prefix:"" }

    target: {
      ts: {
        dir: "ts"
        package: "@voxgig-sdk/joplin-sdk"
        published: false
        pin: "clone https://github.com/voxgig-sdk/joplin-sdk at 89b86ca5df39d8d607091a12a59e988253545874, then npm install <clone>/ts"
      }
      go: {
        dir: "go"
        package: "github.com/voxgig-sdk/joplin-sdk/go"
        published: false
        pin: "github.com/voxgig-sdk/joplin-sdk/go@89b86ca5df39d8d607091a12a59e988253545874"
      }
      py: {
        dir: "py"
        package: "voxgig-sdk-joplin-sdk"
        published: false
        pin: "git+https://github.com/voxgig-sdk/joplin-sdk@89b86ca5df39d8d607091a12a59e988253545874#subdirectory=py"
      }
      rb: {
        dir: "rb"
        package: "voxgig-sdk-joplin-sdk"
        published: false
        pin: "git: 'https://github.com/voxgig-sdk/joplin-sdk', ref: '89b86ca5df39d8d607091a12a59e988253545874', glob: 'rb/*.gemspec'"
      }
      c: {
        dir: "c"
        package: "voxgig-sdk-joplin-sdk"
        published: false
        pin: "vendored from voxgig-sdk/joplin-sdk@89b86ca5df39d8d607091a12a59e988253545874 c/"
      }
    }

    entity: note: accessor: "Note"
    entity: note: name: "note"
    entity: note: idfield: "id"
    entity: note: op: list: {
      name: "list"
      method: "GET"
      route: ["/notes" "/notes/{id}/tags"]
      pages: true
    }
    entity: note: op: load: {
      name: "load"
      method: "GET"
      route: ["/notes/{id}"]
      pages: false
    }
    entity: note: op: create: {
      name: "create"
      method: "POST"
      route: ["/notes"]
      pages: false
    }
    entity: note: op: update: {
      name: "update"
      method: "PUT"
      route: ["/notes/{id}"]
      pages: false
    }
    entity: note: op: remove: {
      name: "remove"
      method: "DELETE"
      route: ["/notes/{id}"]
      pages: false
    }
    entity: folder: accessor: "Folder"
    entity: folder: name: "folder"
    entity: folder: idfield: "id"
    entity: folder: op: list: {
      name: "list"
      method: "GET"
      route: ["/folders" "/folders/{id}/notes"]
      pages: true
    }
    entity: folder: op: load: {
      name: "load"
      method: "GET"
      route: ["/folders/{id}"]
      pages: false
    }
    entity: folder: op: create: {
      name: "create"
      method: "POST"
      route: ["/folders"]
      pages: false
    }
    entity: folder: op: update: {
      name: "update"
      method: "PUT"
      route: ["/folders/{id}"]
      pages: false
    }
    entity: folder: op: remove: {
      name: "remove"
      method: "DELETE"
      route: ["/folders/{id}"]
      pages: false
    }
    entity: tag: accessor: "Tag"
    entity: tag: name: "tag"
    entity: tag: idfield: "id"
    entity: tag: op: list: {
      name: "list"
      method: "GET"
      route: ["/tags" "/tags/{id}/notes"]
      pages: true
    }
    entity: tag: op: load: {
      name: "load"
      method: "GET"
      route: ["/tags/{id}"]
      pages: false
    }
    entity: tag: op: create: {
      name: "create"
      method: "POST"
      route: ["/tags"]
      pages: false
    }
    entity: tag: op: update: {
      name: "update"
      method: "PUT"
      route: ["/tags/{id}"]
      pages: false
    }
    entity: tag: op: remove: {
      name: "remove"
      method: "DELETE"
      route: ["/tags/{id}"]
      pages: false
    }

    test: {
      construct: {
        ts: "JoplinSDK.test({entity: {note: {n1: {id: 'n1'}}}})"
        go: "sdk.TestSDK(map[string]any{\"entity\": ...}, nil)"
        py: "JoplinSDK.test({'entity': {'note': {'n1': {'id': 'n1'}}}})"
        rb: "JoplinSDK.test({'entity' => {'note' => {'n1' => {'id' => 'n1'}}}})"
        c: "test_sdk(seed, NULL)"
      }
      idfield: { note:"id" folder:"id" tag:"id" }
      mints_id: true
      netsim: {
        available: true
        option: [
          "latency"
          "failTimes"
          "failStatus"
          "errorTimes"
          "offline"
          "sleep"
        ]
      }
    }
  }

  obsidian: {
    name: "obsidian"
    repo: "voxgig-sdk/obsidian-sdk"
    # The plugin's own published definition, in full.
    def: "obsidian-local-rest-api-openapi.yaml"
    defkind: "openapi"
    semver: "0.0.1"
    rev: "5e8cd8e4969cec21354e06736bb849935870304a"
    protocol: "http"
    # Reached only through the plugin, on 127.0.0.1, like Joplin.
    local: false
    auth: { kind:"bearer" carrier:"authorization" prefix:"Bearer" }

    target: {
      ts: {
        dir: "ts"
        package: "@voxgig-sdk/obsidian-sdk"
        published: false
        pin: "clone https://github.com/voxgig-sdk/obsidian-sdk at 5e8cd8e4969cec21354e06736bb849935870304a, then npm install <clone>/ts"
      }
      go: {
        dir: "go"
        package: "github.com/voxgig-sdk/obsidian-sdk/go"
        published: false
        pin: "github.com/voxgig-sdk/obsidian-sdk/go@5e8cd8e4969cec21354e06736bb849935870304a"
      }
      py: {
        dir: "py"
        package: "voxgig-sdk-obsidian-sdk"
        published: false
        pin: "git+https://github.com/voxgig-sdk/obsidian-sdk@5e8cd8e4969cec21354e06736bb849935870304a#subdirectory=py"
      }
      rb: {
        dir: "rb"
        package: "voxgig-sdk-obsidian-sdk"
        published: false
        pin: "git: 'https://github.com/voxgig-sdk/obsidian-sdk', ref: '5e8cd8e4969cec21354e06736bb849935870304a', glob: 'rb/*.gemspec'"
      }
      c: {
        dir: "c"
        package: "voxgig-sdk-obsidian-sdk"
        published: false
        pin: "vendored from voxgig-sdk/obsidian-sdk@5e8cd8e4969cec21354e06736bb849935870304a c/"
      }
    }

    entity: {
      vault: accessor: "Vault"
      vault: name: "vault"
      vault: idfield: "id"
      vault: op: list: {
        name: "list"
        method: "GET"
        route: ["/vault/"]
        pages: false
      }
      # Both points select on `id` alone, so the file point is always the one
      # chosen; a directory is listed through it, by an id ending in `/`.
      vault: op: load: {
        name: "load"
        method: "GET"
        route: ["/vault/{filename}" "/vault/{pathToDirectory}/"]
        pages: false
      }
      vault: op: create: {
        name: "create"
        method: "POST"
        route: ["/vault/{filename}"]
        pages: false
      }
      vault: op: update: {
        name: "update"
        method: "PUT"
        route: ["/vault/{filename}"]
        pages: false
      }
      vault: op: patch: {
        name: "patch"
        method: "PATCH"
        route: ["/vault/{filename}"]
        pages: false
      }
      vault: op: remove: {
        name: "remove"
        method: "DELETE"
        route: ["/vault/{filename}"]
        pages: false
      }
      tag: accessor: "Tag"
      tag: name: "tag"
      tag: idfield: "id"
      tag: op: list: { name:"list" method:"GET" route: ["/tags/"] pages:false }
      search: accessor: "Search"
      search: name: "search"
      search: idfield: "id"
      search: op: create: {
        name: "create"
        method: "POST"
        route: ["/search/simple/" "/search/"]
        pages: false
      }
      open: accessor: "Open"
      open: name: "open"
      open: idfield: "id"
      open: op: create: {
        name: "create"
        method: "POST"
        route: ["/open/{filename}"]
        pages: false
      }
      active: accessor: "Active"
      active: name: "active"
      active: idfield: "id"
      active: op: load: {
        name: "load"
        method: "GET"
        route: ["/active/"]
        pages: false
      }
      active: op: create: {
        name: "create"
        method: "POST"
        route: ["/active/"]
        pages: false
      }
      active: op: update: {
        name: "update"
        method: "PUT"
        route: ["/active/"]
        pages: false
      }
      active: op: patch: {
        name: "patch"
        method: "PATCH"
        route: ["/active/"]
        pages: false
      }
      active: op: remove: {
        name: "remove"
        method: "DELETE"
        route: ["/active/"]
        pages: false
      }
      command: accessor: "Command"
      command: name: "command"
      command: idfield: "id"
      command: op: list: {
        name: "list"
        method: "GET"
        route: ["/commands/"]
        pages: false
      }
      command: op: create: {
        name: "create"
        method: "POST"
        route: ["/commands/{commandId}/"]
        pages: false
      }
      system: accessor: "System"
      system: name: "system"
      system: idfield: "id"
      system: op: load: {
        name: "load"
        method: "GET"
        route: ["/obsidian-local-rest-api.crt" "/openapi.yaml"]
        pages: false
      }
      mcp: accessor: "Mcp"
      mcp: name: "mcp"
      mcp: idfield: "id"
      mcp: op: load: { name:"load" method:"GET" route: ["/mcp/"] pages:false }
      mcp: op: create: {
        name: "create"
        method: "POST"
        route: ["/mcp/"]
        pages: false
      }
      entity1: accessor: "Entity1"
      entity1: name: "entity1"
      entity1: idfield: "id"
      entity1: op: load: { name:"load" method:"GET" route: ["/"] pages:false }
    }

    test: {
      construct: {
        ts: "ObsidianSDK.test({entity: {vault: {'a.md': {id: 'a.md'}}}})"
        go: "sdk.TestSDK(map[string]any{\"entity\": ...}, nil)"
        py: "ObsidianSDK.test({'entity': {'vault': {'a.md': {'id': 'a.md'}}}})"
        rb: "ObsidianSDK.test({'entity' => {'vault' => {'a.md' => {'id' => 'a.md'}}}})"
        c: "test_sdk(seed, NULL)"
      }
      # As the SDK's own resolver derives them. `active` has no path parameter,
      # and the resolver takes its optional `permanent` query parameter instead.
      idfield: active: "permanent"
      idfield: command: "id"
      idfield: entity1: "id"
      idfield: mcp: "id"
      idfield: open: "id"
      idfield: search: "id"
      idfield: system: "id"
      idfield: tag: "id"
      idfield: vault: "id"
      mints_id: true
      netsim: {
        available: true
        option: [
          "latency"
          "failTimes"
          "failStatus"
          "errorTimes"
          "offline"
          "sleep"
        ]
      }
    }
  }

  notion: {
    name: "notion"
    repo: "voxgig-sdk/notion-sdk"
    def: "notion-pages-databases-only.json"
    defkind: "openapi"
    semver: "0.0.1"
    rev: "1e45fc399a541f60c26a4d78fd76559456e61b56"
    protocol: "http"
    local: false
    auth: { kind:"bearer" carrier:"authorization" prefix:"Bearer" }

    target: {
      ts: {
        dir: "ts"
        package: "@voxgig-sdk/notion-sdk"
        published: false
        pin: "clone https://github.com/voxgig-sdk/notion-sdk at 1e45fc399a541f60c26a4d78fd76559456e61b56, then npm install <clone>/ts"
      }
      go: {
        dir: "go"
        package: "github.com/voxgig-sdk/notion-sdk/go"
        published: false
        pin: "github.com/voxgig-sdk/notion-sdk/go@1e45fc399a541f60c26a4d78fd76559456e61b56"
      }
      py: {
        dir: "py"
        package: "voxgig-sdk-notion-sdk"
        published: false
        pin: "git+https://github.com/voxgig-sdk/notion-sdk@1e45fc399a541f60c26a4d78fd76559456e61b56#subdirectory=py"
      }
      rb: {
        dir: "rb"
        package: "voxgig-sdk-notion-sdk"
        published: false
        pin: "git: 'https://github.com/voxgig-sdk/notion-sdk', ref: '1e45fc399a541f60c26a4d78fd76559456e61b56', glob: 'rb/*.gemspec'"
      }
      c: {
        dir: "c"
        package: "voxgig-sdk-notion-sdk"
        published: false
        pin: "vendored from voxgig-sdk/notion-sdk@1e45fc399a541f60c26a4d78fd76559456e61b56 c/"
      }
    }

    # NO `list` AND NO `remove` ON EITHER ENTITY. That is not an omission here:
    # the generated SDK has neither, so likeness cannot list or delete a Notion
    # page through it, and the capability matrix must say so rather than let a
    # refusal become a lie.
    entity: page: accessor: "Page"
    entity: page: name: "page"
    entity: page: idfield: "id"
    entity: page: op: load: {
      name: "load"
      method: "GET"
      route: ["/pages/{id}"]
      pages: false
    }
    entity: page: op: create: {
      name: "create"
      method: "POST"
      route: ["/pages"]
      pages: false
    }
    entity: page: op: update: {
      name: "update"
      method: "PATCH"
      route: ["/pages/{id}"]
      pages: false
    }
    entity: database: accessor: "Database"
    entity: database: name: "database"
    entity: database: idfield: "id"
    entity: database: op: load: {
      name: "load"
      method: "GET"
      route: ["/databases/{id}"]
      pages: false
    }
    entity: database: op: create: {
      name: "create"
      method: "POST"
      route: ["/databases"]
      pages: false
    }
    entity: database: op: update: {
      name: "update"
      method: "PATCH"
      route: ["/databases/{id}"]
      pages: false
    }

    test: {
      construct: {
        ts: "NotionSDK.test({entity: {page: {p1: {id: 'p1'}}}})"
        go: "sdk.TestSDK(map[string]any{\"entity\": ...}, nil)"
        py: "NotionSDK.test({'entity': {'page': {'p1': {'id': 'p1'}}}})"
        rb: "NotionSDK.test({'entity' => {'page' => {'p1' => {'id' => 'p1'}}}})"
        c: "test_sdk(seed, NULL)"
      }
      idfield: { page:"id" database:"id" }
      mints_id: true
      netsim: {
        available: true
        option: [
          "latency"
          "failTimes"
          "failStatus"
          "errorTimes"
          "offline"
          "sleep"
        ]
      }
    }
  }

  linear: {
    name: "linear"
    repo: "voxgig-sdk/linear-sdk"
    # A GraphQL SDL, consumed DIRECTLY by sdkgen. There is no hand-written
    # OpenAPI wrapper over /graphql, and none is needed.
    def: "linear-issues-only.graphql"
    defkind: "graphql"
    semver: "0.0.1"
    rev: "046371226512e1faa497905086b254f9ba41b563"
    protocol: "graphql"
    local: false
    # NO SCHEME PREFIX, unlike obsidian and notion. linear's Config declares
    # `auth: { prefix: '' }`, and PrepareAuthUtility only prepends a scheme when
    # one is configured, so the header carries the raw credential - which is
    # what Linear's API wants.
    auth: { kind:"raw-header" carrier:"authorization" prefix:"" }

    target: {
      ts: {
        dir: "ts"
        package: "@voxgig-sdk/linear"
        published: false
        pin: "clone https://github.com/voxgig-sdk/linear-sdk at 046371226512e1faa497905086b254f9ba41b563, then npm install <clone>/ts"
      }
      go: {
        dir: "go"
        package: "github.com/voxgig-sdk/linear-sdk/go"
        published: false
        pin: "github.com/voxgig-sdk/linear-sdk/go@046371226512e1faa497905086b254f9ba41b563"
      }
      py: {
        dir: "py"
        package: "voxgig-sdk-linear"
        published: false
        pin: "git+https://github.com/voxgig-sdk/linear-sdk@046371226512e1faa497905086b254f9ba41b563#subdirectory=py"
      }
      rb: {
        dir: "rb"
        package: "voxgig-sdk-linear"
        published: false
        pin: "git: 'https://github.com/voxgig-sdk/linear-sdk', ref: '046371226512e1faa497905086b254f9ba41b563', glob: 'rb/*.gemspec'"
      }
      c: {
        dir: "c"
        package: "voxgig-sdk-linear"
        published: false
        pin: "vendored from voxgig-sdk/linear-sdk@046371226512e1faa497905086b254f9ba41b563 c/"
      }
    }

    # Every operation is a POST to the one endpoint; `route` names the GraphQL
    # field rather than a path, because that is what distinguishes them.
    entity: issue: accessor: "Issue"
    entity: issue: name: "issue"
    entity: issue: idfield: "id"
    entity: issue: op: list: {
      name: "list"
      method: "POST"
      route: ["issues"]
      pages: true
    }
    entity: issue: op: load: {
      name: "load"
      method: "POST"
      route: ["issue"]
      pages: false
    }
    entity: issue: op: create: {
      name: "create"
      method: "POST"
      route: ["issueCreate"]
      pages: false
    }
    entity: issue: op: update: {
      name: "update"
      method: "POST"
      route: ["issueUpdate"]
      pages: false
    }
    entity: team: accessor: "Team"
    entity: team: name: "team"
    entity: team: idfield: "id"
    entity: team: op: list: {
      name: "list"
      method: "POST"
      route: ["teams"]
      # `teams(first, after): [Team!]!` is a plain list, not a relay connection:
      # there is no pageInfo, and the op's model carries no `graphql.page`, so
      # nothing can be followed. `issues` is the connection; this is not.
      pages: false
    }
    entity: team: op: load: {
      name: "load"
      method: "POST"
      route: ["team"]
      pages: false
    }

    test: {
      construct: {
        ts: "LinearSDK.test({entity: {issue: {i1: {id: 'i1'}}}})"
        go: "sdk.TestSDK(map[string]any{\"entity\": ...}, nil)"
        py: "LinearSDK.test({'entity': {'issue': {'i1': {'id': 'i1'}}}})"
        rb: "LinearSDK.test({'entity' => {'issue' => {'i1' => {'id' => 'i1'}}}})"
        c: "test_sdk(seed, NULL)"
      }
      idfield: { issue:"id" team:"id" }
      mints_id: true
      netsim: {
        available: true
        option: [
          "latency"
          "failTimes"
          "failStatus"
          "errorTimes"
          "offline"
          "sleep"
        ]
      }
    }
  }
}
