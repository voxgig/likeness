primary: cli: {
  args: set: [
    {
      id: "args/dash-selector-refused-before-the-network"
      # A positional that begins with `-` is a flag unless it follows `--`.
      args: ["list" "-title:limit title:e" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:3 stdout:"spec/expect/args/dash-selector.json" calls: [] }
    }

    {
      id: "args/undeclared-flag-refused-before-the-network"
      # An undeclared flag was once read as a selector term, hiding rows.
      args: ["list" "--bogus" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:3 stdout:"spec/expect/args/undeclared-flag.json" calls: [] }
    }

    {
      id: "args/flag-before-the-command"
      args: ["--json" "list"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 3
        stdout: "spec/expect/args/flag-before-the-command.json"
        calls: []
      }
    }

    {
      id: "args/limit-equals-form"
      # `--flag=value` and `--flag value` are one form.
      args: ["list" "--limit=2" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
        stdout: "spec/expect/list/limit-truncates.json"
        calls: [{ instance:"joplin" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "args/selector-terms-joined"
      # The selector's terms, given as separate arguments, are joined with spaces.
      args: ["list" "title:retention" "title:policy" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
        stdout: "spec/expect/args/selector-terms-joined.json"
        calls: [{ instance:"joplin" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "args/surplus-positional"
      args: ["version" "extra" "--json"]
      ctx: {
        fixture: "joplin"
        connections: []
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 3
        stdout: "spec/expect/args/surplus-positional.json"
        calls: []
      }
    }

    {
      id: "args/given-twice"
      args: ["list" "--limit" "2" "--limit" "3" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:3 stdout:"spec/expect/args/given-twice.json" calls: [] }
    }

    {
      id: "args/stub-reads-only-its-globals"
      args: ["search" "anything" "--bogus" "--json"]
      ctx: {
        fixture: "joplin"
        connections: []
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 4
        stdout: "spec/expect/args/stub-reads-only-its-globals.json"
        calls: []
      }
    }

    {
      id: "args/help-overview"
      # Help is rendered from the command table at build time (SPEC 13.1 rule 9).
      args: ["help"]
      ctx: {
        fixture: "joplin"
        connections: []
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:0 stdout:"spec/expect/args/help-overview.txt" calls: [] }
    }

    {
      id: "args/help-one-command"
      args: ["help" "list"]
      ctx: {
        fixture: "joplin"
        connections: []
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:0 stdout:"spec/expect/args/help-list.txt" calls: [] }
    }

    {
      id: "args/help-one-command-json"
      args: ["help" "get" "--json"]
      ctx: {
        fixture: "joplin"
        connections: []
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:0 stdout:"spec/expect/args/help-get.json" calls: [] }
    }

    {
      id: "args/help-unknown-command"
      args: ["help" "nosuch" "--json"]
      ctx: {
        fixture: "joplin"
        connections: []
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 3
        stdout: "spec/expect/args/help-unknown-command.json"
        calls: []
      }
    }

    {
      id: "args/short-help-flag"
      args: ["-h" "list"]
      ctx: {
        fixture: "joplin"
        connections: []
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:0 stdout:"spec/expect/args/help-list.txt" calls: [] }
    }
  ]

  list: set: [
    {
      id: "list/all"
      args: ["list" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
        stdout: "spec/expect/list/all.json"
        calls: [{ instance:"joplin" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/free-text"
      # A bareword with no field is a case-insensitive substring over title and
      # body. Note 1 has it in the title, note 2 in the body, note 3 nowhere.
      args: ["list" "retention" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
        stdout: "spec/expect/list/free-text.json"
        calls: [{ instance:"joplin" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/relative-duration"
      args: ["list" "updated>3d" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
        stdout: "spec/expect/list/relative-duration.json"
        calls: [{ instance:"joplin" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/limit-truncates"
      args: ["list" "--limit" "2" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
        stdout: "spec/expect/list/limit-truncates.json"
        calls: [{ instance:"joplin" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/no-match"
      args: ["list" "title:nothingmatchesthis" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        # EXIT 1 IS NOT AN ERROR. The question was valid and the answer is
        # nothing, so `ok` stays true, `data` is an empty list rather than null,
        # and the code is `no-match` rather than a failure a script would stop
        # on. The source WAS asked, so the call list is not empty.
        exit: 1
        stdout: "spec/expect/list/no-match.json"
        calls: [{ instance:"joplin" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/human"
      # No `--json`. Human output is part of the contract too, and it is pinned
      # with no stripping at all because it carries no envelope.
      args: ["list"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
        stdout: "spec/expect/list/human.txt"
        calls: [{ instance:"joplin" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/human-no-match"
      # Nothing matched: print NOTHING. An empty list joined by newlines is a
      # blank line, which reads as one unnamed result and breaks `wc -l`.
      args: ["list" "title:nothingmatchesthis"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 1
        stdout: "spec/expect/list/human-no-match.txt"
        calls: [{ instance:"joplin" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/invalid-selector-refuses-before-the-network"
      args: ["list" "bogusfield:x" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:3 stdout:"spec/expect/list/invalid-selector.json" calls: [] }
    }

    {
      id: "list/unanswerable-field-refused-before-the-network"
      args: ["list" "tag:anything" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 4
        stdout: "spec/expect/list/unanswerable-field.json"
        calls: []
      }
    }

    {
      id: "list/unknown-instance-filter"
      args: ["list" "--instance" "jopln" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 3
        stdout: "spec/expect/list/unknown-instance-filter.json"
        calls: []
      }
    }

    {
      id: "list/unknown-source-filter"
      args: ["list" "--source" "notion" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 3
        stdout: "spec/expect/list/unknown-source-filter.json"
        calls: []
      }
    }

    {
      id: "list/invalid-limit"
      args: ["list" "--limit" "nope" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:3 stdout:"spec/expect/list/invalid-limit.json" calls: [] }
    }

    # `--limit` is an integer in the declared grammar: digits only, within its
    # bounds. A host number parser accepts hex, exponents and decimals, and
    # each port accepted a different set.
    {
      id: "list/limit-hex-refused"
      args: ["list" "--limit" "0x10" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:3 stdout:"spec/expect/list/limit-hex.json" calls: [] }
    }

    {
      id: "list/limit-exponent-refused"
      args: ["list" "--limit" "1e3" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:3 stdout:"spec/expect/list/limit-exponent.json" calls: [] }
    }

    {
      id: "list/limit-decimal-refused"
      args: ["list" "--limit" "2.0" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:3 stdout:"spec/expect/list/limit-decimal.json" calls: [] }
    }

    {
      id: "list/limit-overflow-refused"
      args: ["list" "--limit" "99999999999999999999" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:3 stdout:"spec/expect/list/limit-overflow.json" calls: [] }
    }

    {
      id: "list/limit-ten-digits-refused"
      args: ["list" "--limit" "1000000000" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:3 stdout:"spec/expect/list/limit-ten-digits.json" calls: [] }
    }

    {
      id: "list/duration-overflow-refused-before-the-network"
      args: ["list" "updated>99999999999999999999d" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:3 stdout:"spec/expect/list/duration-overflow.json" calls: [] }
    }

    {
      id: "list/ordering-on-title-refused-before-the-network"
      args: ["list" "title>2026-01-01" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:3 stdout:"spec/expect/list/ordering-on-title.json" calls: [] }
    }

    {
      id: "list/no-adapter-refused-before-the-network"
      args: ["list" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"notion" account:"acme" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:4 stdout:"spec/expect/list/no-adapter.json" calls: [] }
    }

    {
      id: "list/all-sources-down"
      args: ["list" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [
          { instance:"joplin" account:"local" net:offline:true }
          { instance:"joplin$spare" account:"spare" net:offline:true }
        ]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 3
        stdout: "spec/expect/list/all-sources-down.json"
        calls: [
          { instance:"joplin" method:"GET" path:"/notes" }
          { instance:"joplin$spare" method:"GET" path:"/notes" }
        ]
      }
    }

    {
      id: "list/strict-halts-on-the-first-failure"
      # THE ENTRY THAT MAKES `fanout-halted` MEAN WHAT IT SAYS. The failing
      # connection is FIRST, so a port that halted would call once and a port
      # that merely relabelled the result at the end would call twice. Only the
      # call list can tell those apart, which is the whole argument for
      # asserting it.
      args: ["list" "--strict" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [
          { instance:"joplin" account:"down" net:offline:true }
          { instance:"joplin$up" account:"local" }
        ]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 4
        stdout: "spec/expect/list/strict-halts-first.json"
        calls: [{ instance:"joplin" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/partial"
      args: ["list" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [
          { instance:"joplin" account:"local" }
          { instance:"joplin$spare" account:"spare" net:offline:true }
        ]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 2
        stdout: "spec/expect/list/partial.json"
        calls: [
          { instance:"joplin" method:"GET" path:"/notes" }
          { instance:"joplin$spare" method:"GET" path:"/notes" }
        ]
      }
    }

    {
      id: "list/partial-human"
      # The same run without `--json`. THE WARNING GOES TO STDERR and the rows
      # go to stdout, so a pipeline keeps working and a human still finds out.
      args: ["list"]
      ctx: {
        fixture: "joplin"
        connections: [
          { instance:"joplin" account:"local" }
          { instance:"joplin$spare" account:"spare" net:offline:true }
        ]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 2
        stdout: "spec/expect/list/partial-human.txt"
        stderr: "joplin$spare unavailable - results are incomplete\n"
        calls: [
          { instance:"joplin" method:"GET" path:"/notes" }
          { instance:"joplin$spare" method:"GET" path:"/notes" }
        ]
      }
    }

    {
      id: "list/strict-halts-the-fanout"
      args: ["list" "--strict" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [
          { instance:"joplin" account:"local" }
          { instance:"joplin$spare" account:"spare" net:offline:true }
        ]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 4
        stdout: "spec/expect/list/strict-halts.json"
        calls: [
          { instance:"joplin" method:"GET" path:"/notes" }
          { instance:"joplin$spare" method:"GET" path:"/notes" }
        ]
      }
    }

    {
      id: "list/odd-values-project-the-same-everywhere"
      # The awkward fixture: null, non-string and float values, keys out of order, markup and control characters. One rule per field.
      args: ["list" "--json"]
      ctx: {
        fixture: "joplin-odd"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
        stdout: "spec/expect/list/odd-values.json"
        calls: [{ instance:"joplin" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/odd-raw-is-the-canonical-writer"
      args: ["list" "--raw" "--json"]
      ctx: {
        fixture: "joplin-odd"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
        stdout: "spec/expect/list/odd-raw.json"
        calls: [{ instance:"joplin" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/case-folding-is-ascii-only"
      # `İ` does not fold to `i`. A port that used its language's lowercasing matched here.
      args: ["list" "title:istanbul" "--json"]
      ctx: {
        fixture: "joplin-odd"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 1
        stdout: "spec/expect/list/odd-no-match.json"
        calls: [{ instance:"joplin" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/case-folding-folds-ascii"
      args: ["list" "title:STRA" "--json"]
      ctx: {
        fixture: "joplin-odd"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
        stdout: "spec/expect/list/odd-strasse.json"
        calls: [{ instance:"joplin" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/no-full-case-folding"
      args: ["list" "title:STRASSE" "--json"]
      ctx: {
        fixture: "joplin-odd"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 1
        stdout: "spec/expect/list/odd-no-match.json"
        calls: [{ instance:"joplin" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/negation-after-a-term"
      # The same question asked in both orders, so both entries share one
      # expectation file: a port that parsed only one of them cannot pass.
      args: ["list" "title:e -title:limit" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
        stdout: "spec/expect/list/negation.json"
        calls: [{ instance:"joplin" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/negation-before-a-term"
      # A selector that begins with `-` follows `--` (SPEC 13.1 rule 4).
      args: ["list" "--json" "--" "-title:limit title:e"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
        stdout: "spec/expect/list/negation.json"
        calls: [{ instance:"joplin" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/instance-filter"
      # `--instance` narrows the fan-out BEFORE it happens: the second
      # connection is never called, which the empty second call proves.
      args: ["list" "--instance" "joplin" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [
          { instance:"joplin" account:"local" }
          { instance:"joplin$spare" account:"spare" net:offline:true }
        ]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
        stdout: "spec/expect/list/instance-filter.json"
        calls: [{ instance:"joplin" method:"GET" path:"/notes" }]
      }
    }
  ]

  # -------------------------------------------------------------------- get
  get: set: [
    {
      id: "get/one"
      args: ["get" "joplin:a0e50000000000000000000000000001" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
        stdout: "spec/expect/get/one.json"
        calls: [
          {
            instance: "joplin"
            method: "GET"
            path: "/notes/a0e50000000000000000000000000001"
          }
        ]
      }
    }

    {
      id: "get/odd-raw-one"
      args: ["get" "joplin:a0e50000000000000000000000000013" "--raw" "--json"]
      ctx: {
        fixture: "joplin-odd"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
