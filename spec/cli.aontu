primary: cli: {
  list: set: [
    {
      id: "list/all"
      args: ["list" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"jot" source:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
        stdout: "spec/expect/list/all.json"
        calls: [{ instance:"jot" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/free-text"
      # A bareword with no field is a case-insensitive substring over title and
      # body. Note 1 has it in the title, note 2 in the body, note 3 nowhere.
      args: ["list" "retention" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"jot" source:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
        stdout: "spec/expect/list/free-text.json"
        calls: [{ instance:"jot" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/relative-duration"
      args: ["list" "updated>3d" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"jot" source:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
        stdout: "spec/expect/list/relative-duration.json"
        calls: [{ instance:"jot" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/limit-truncates"
      args: ["list" "--limit" "2" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"jot" source:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
        stdout: "spec/expect/list/limit-truncates.json"
        calls: [{ instance:"jot" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/no-match"
      args: ["list" "title:nothingmatchesthis" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"jot" source:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        # EXIT 1 IS NOT AN ERROR. The question was valid and the answer is
        # nothing, so `ok` stays true, `data` is an empty list rather than null,
        # and the code is `no-match` rather than a failure a script would stop
        # on. The source WAS asked, so the call list is not empty.
        exit: 1
        stdout: "spec/expect/list/no-match.json"
        calls: [{ instance:"jot" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/human"
      # No `--json`. Human output is part of the contract too, and it is pinned
      # with no stripping at all because it carries no envelope.
      args: ["list"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"jot" source:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
        stdout: "spec/expect/list/human.txt"
        calls: [{ instance:"jot" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/human-no-match"
      # Nothing matched: print NOTHING. An empty list joined by newlines is a
      # blank line, which reads as one unnamed result and breaks `wc -l`.
      args: ["list" "title:nothingmatchesthis"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"jot" source:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 1
        stdout: "spec/expect/list/human-no-match.txt"
        calls: [{ instance:"jot" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/invalid-selector-refuses-before-the-network"
      args: ["list" "bogusfield:x" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"jot" source:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:3 stdout:"spec/expect/list/invalid-selector.json" calls: [] }
    }

    {
      id: "list/unanswerable-field-refused-before-the-network"
      args: ["list" "tag:anything" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"jot" source:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 4
        stdout: "spec/expect/list/unanswerable-field.json"
        calls: []
      }
    }

    {
      id: "list/unknown-instance-filter"
      args: ["list" "--instance" "jto" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"jot" source:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 3
        stdout: "spec/expect/list/unknown-instance-filter.json"
        calls: []
      }
    }

    {
      id: "list/unknown-source-filter"
      args: ["list" "--source" "notion" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"jot" source:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 3
        stdout: "spec/expect/list/unknown-source-filter.json"
        calls: []
      }
    }

    {
      id: "list/invalid-limit"
      args: ["list" "--limit" "nope" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"jot" source:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:3 stdout:"spec/expect/list/invalid-limit.json" calls: [] }
    }

    {
      id: "list/no-adapter-refused-before-the-network"
      args: ["list" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"pages" source:"notion" account:"acme" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:4 stdout:"spec/expect/list/no-adapter.json" calls: [] }
    }

    {
      id: "list/all-sources-down"
      args: ["list" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [
          { instance:"jot" source:"joplin" account:"local" net:offline:true }
          { instance:"spare" source:"joplin" account:"spare" net:offline:true }
        ]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 3
        stdout: "spec/expect/list/all-sources-down.json"
        calls: [
          { instance:"jot" method:"GET" path:"/notes" }
          { instance:"spare" method:"GET" path:"/notes" }
        ]
      }
    }

    {
      id: "list/strict-halts-on-the-first-failure"
      # THE ENTRY THAT MAKES `fanout-halted` MEAN WHAT IT SAYS. The failing
      # connection is FIRST, so a port that halted would call once and a port
      # that merely relabelled the result at the end would call twice. Only the
      # call list can tell those apart, which is the whole argument for
      # asserting it.
      args: ["list" "--strict" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [
          { instance:"down" source:"joplin" account:"down" net:offline:true }
          { instance:"jot" source:"joplin" account:"local" }
        ]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 4
        stdout: "spec/expect/list/strict-halts-first.json"
        calls: [{ instance:"down" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/partial"
      args: ["list" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [
          { instance:"jot" source:"joplin" account:"local" }
          { instance:"spare" source:"joplin" account:"spare" net:offline:true }
        ]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 2
        stdout: "spec/expect/list/partial.json"
        calls: [
          { instance:"jot" method:"GET" path:"/notes" }
          { instance:"spare" method:"GET" path:"/notes" }
        ]
      }
    }

    {
      id: "list/partial-human"
      # The same run without `--json`. THE WARNING GOES TO STDERR and the rows
      # go to stdout, so a pipeline keeps working and a human still finds out.
      args: ["list"]
      ctx: {
        fixture: "joplin"
        connections: [
          { instance:"jot" source:"joplin" account:"local" }
          { instance:"spare" source:"joplin" account:"spare" net:offline:true }
        ]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 2
        stdout: "spec/expect/list/partial-human.txt"
        stderr: "spare unavailable - results are incomplete\n"
        calls: [
          { instance:"jot" method:"GET" path:"/notes" }
          { instance:"spare" method:"GET" path:"/notes" }
        ]
      }
    }

    {
      id: "list/strict-halts-the-fanout"
      args: ["list" "--strict" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [
          { instance:"jot" source:"joplin" account:"local" }
          { instance:"spare" source:"joplin" account:"spare" net:offline:true }
        ]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 4
        stdout: "spec/expect/list/strict-halts.json"
        calls: [
          { instance:"jot" method:"GET" path:"/notes" }
          { instance:"spare" method:"GET" path:"/notes" }
        ]
      }
    }

    {
      id: "list/instance-filter"
      # `--instance` narrows the fan-out BEFORE it happens: the second
      # connection is never called, which the empty second call proves.
      args: ["list" "--instance" "jot" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [
          { instance:"jot" source:"joplin" account:"local" }
          { instance:"spare" source:"joplin" account:"spare" net:offline:true }
        ]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
        stdout: "spec/expect/list/instance-filter.json"
        calls: [{ instance:"jot" method:"GET" path:"/notes" }]
      }
    }
  ]

  # -------------------------------------------------------------------- get
  get: set: [
    {
      id: "get/one"
      args: ["get" "jot:a0e50000000000000000000000000001" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"jot" source:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
        stdout: "spec/expect/get/one.json"
        calls: [
          {
            instance: "jot"
            method: "GET"
            path: "/notes/a0e50000000000000000000000000001"
          }
        ]
      }
    }

    {
      id: "get/not-found"
      # Exit 1, like `no-match`: the ref was well formed and there is no such
      # record. The source WAS asked, so there is one call.
      args: ["get" "jot:nosuchnote" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"jot" source:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 1
        stdout: "spec/expect/get/not-found.json"
        calls: [{ instance:"jot" method:"GET" path:"/notes/nosuchnote" }]
      }
    }

    {
      id: "get/no-ref"
      args: ["get" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"jot" source:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:3 stdout:"spec/expect/get/no-ref.json" calls: [] }
    }

    {
      id: "get/unparseable-ref"
      args: ["get" "nocolonhere" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"jot" source:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:3 stdout:"spec/expect/get/unparseable-ref.json" calls: [] }
    }

    {
      id: "get/empty-id"
      args: ["get" "jot:" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"jot" source:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:3 stdout:"spec/expect/get/empty-id.json" calls: [] }
    }

    {
      id: "get/unknown-instance"
      # THE SECOND REFUSAL-BEFORE-THE-NETWORK ENTRY. No connection is named
      # `absent`, which is knowable without asking anyone, so no call is made.
      args: ["get" "absent:x" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"jot" source:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:3 stdout:"spec/expect/get/unknown-instance.json" calls: [] }
    }
  ]

  # ----------------------------------------------------------------- doctor
  doctor: set: [
    {
      id: "doctor/ok"
      args: ["doctor" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"jot" source:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
        stdout: "spec/expect/doctor/ok.json"
        calls: [{ instance:"jot" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "doctor/unreachable"
      args: ["doctor" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [
          { instance:"jot" source:"joplin" account:"local" net:offline:true }
        ]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 3
        stdout: "spec/expect/doctor/unreachable.json"
        calls: [{ instance:"jot" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "doctor/auth-rejected"
      args: ["doctor" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [
          {
            instance: "jot"
            source: "joplin"
            account: "local"
            net: { failTimes:1 failStatus:401 }
          }
        ]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 3
        stdout: "spec/expect/doctor/auth-rejected.json"
        calls: [{ instance:"jot" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "doctor/no-adapter-is-reported"
      # `doctor` REPORTS rather than refuses: naming the unsupported source is
      # exactly the diagnosis the command exists to give, and it costs no call.
      args: ["doctor" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [
          { instance:"jot" source:"joplin" account:"local" }
          { instance:"pages" source:"notion" account:"acme" }
        ]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 4
        stdout: "spec/expect/doctor/no-adapter.json"
        calls: [{ instance:"jot" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "doctor/mixed-failures"
      args: ["doctor" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [
          { instance:"jot" source:"joplin" account:"local" net:offline:true }
          {
            instance: "spare"
            source: "joplin"
            account: "spare"
            net: { failTimes:1 failStatus:401 }
          }
        ]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 3
        stdout: "spec/expect/doctor/mixed-failures.json"
        calls: [
          { instance:"jot" method:"GET" path:"/notes" }
          { instance:"spare" method:"GET" path:"/notes" }
        ]
      }
    }
  ]

  meta: set: [
    {
      id: "meta/version"
      args: ["version" "--json"]
      ctx: {
        fixture: "joplin"
        connections: []
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:0 stdout:"spec/expect/meta/version.json" calls: [] }
    }

    {
      id: "meta/which"
      args: ["which" "--json"]
      ctx: {
        fixture: "joplin"
        connections: []
        clock: "2026-09-18T00:00:00Z"
        seed: 1
        path: [
          { path:"/usr/local/bin/likeness" port:"" version:"" }
          { path:"/usr/local/bin/likeness-go" port:"go" version:"" }
          { path:"/usr/local/bin/likeness-ts" port:"ts" version:"" }
        ]
      }
      out: { exit:0 stdout:"spec/expect/meta/which.json" calls: [] }
    }

    {
      id: "meta/which-none"
      # Nothing installed under a matching name is the answer "none", exit 1 -
      # not a row claiming this port is the only installation.
      args: ["which" "--json"]
      ctx: {
        fixture: "joplin"
        connections: []
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:1 stdout:"spec/expect/meta/which-none.json" calls: [] }
    }

    {
      id: "meta/help"
      args: ["help" "--json"]
      ctx: {
        fixture: "joplin"
        connections: []
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:0 stdout:"spec/expect/meta/help.json" calls: [] }
    }

    {
      id: "meta/help-flag"
      args: ["--help" "--json"]
      ctx: {
        fixture: "joplin"
        connections: []
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:0 stdout:"spec/expect/meta/help.json" calls: [] }
    }

    {
      id: "meta/stub-is-honest"
      # A stub that EXISTS and says it does not work yet. The alternative -
      # no such command - tells a user their installation is broken, and the
      # alternative to that, silence, is worse.
      args: ["search" "anything" "--json"]
      ctx: {
        fixture: "joplin"
        connections: []
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:4 stdout:"spec/expect/meta/stub.json" calls: [] }
    }

    {
      id: "meta/unknown-command"
      args: ["nosuchcommand" "--json"]
      ctx: {
        fixture: "joplin"
        connections: []
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:3 stdout:"spec/expect/meta/unknown-command.json" calls: [] }
    }

    {
      id: "meta/no-command"
      # Bare `likeness`, with no arguments at all. NOTHING ON STDOUT and the
      # complaint on stderr, so a pipeline reading stdout gets an empty stream
      # rather than an error message it will try to parse.
      args: []
      ctx: {
        fixture: "joplin"
        connections: []
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 3
        stdout: "spec/expect/meta/no-command.txt"
        stderr: "error: invalid-selector\n  no command given\n  remedy  try `likeness list`, or `likeness help` for the command list\n"
        calls: []
      }
    }
  ]
}
