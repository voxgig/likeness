      ctx: {
        fixture: "joplin"
        connections: [{ instance:"linear" account:"acme" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:4 stdout:"spec/expect/list/no-adapter.json" calls: [] }
    }

    {
      id: "list/all-sources-down"
      args: ["list" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [
          { instance:"joplin" account:"local" net:offline:true }
          { instance:"joplin$spare" account:"spare" net:offline:true }
        ]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 3
        stdout: "spec/expect/list/all-sources-down.json"
        calls: [
          { instance:"joplin" method:"GET" path:"/notes" }
          { instance:"joplin$spare" method:"GET" path:"/notes" }
        ]
      }
    }

    {
      id: "list/strict-halts-on-the-first-failure"
      # THE ENTRY THAT MAKES `fanout-halted` MEAN WHAT IT SAYS. The failing
      # connection is FIRST, so a port that halted would call once and a port
      # that merely relabelled the result at the end would call twice. Only the
      # call list can tell those apart, which is the whole argument for
      # asserting it.
      args: ["list" "--strict" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [
          { instance:"joplin" account:"down" net:offline:true }
          { instance:"joplin$up" account:"local" }
        ]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 4
        stdout: "spec/expect/list/strict-halts-first.json"
        calls: [{ instance:"joplin" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/partial"
      args: ["list" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [
          { instance:"joplin" account:"local" }
          { instance:"joplin$spare" account:"spare" net:offline:true }
        ]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 2
        stdout: "spec/expect/list/partial.json"
        calls: [
          { instance:"joplin" method:"GET" path:"/notes" }
          { instance:"joplin$spare" method:"GET" path:"/notes" }
        ]
      }
    }

    {
      id: "list/two-instances-answer"
      # One record held in more than one account is a note per account, each
      # with its own lid and naming the instance that answered, a tagged one
      # included.
      args: ["list" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [
          { instance:"joplin" account:"local" }
          { instance:"joplin$spare" account:"spare" }
        ]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
        stdout: "spec/expect/list/two-instances-answer.json"
        calls: [
          { instance:"joplin" method:"GET" path:"/notes" }
          { instance:"joplin$spare" method:"GET" path:"/notes" }
        ]
      }
    }

    {
      id: "list/partial-human"
      # The same run without `--json`. THE WARNING GOES TO STDERR and the rows
      # go to stdout, so a pipeline keeps working and a human still finds out.
      args: ["list"]
      ctx: {
        fixture: "joplin"
        connections: [
          { instance:"joplin" account:"local" }
          { instance:"joplin$spare" account:"spare" net:offline:true }
        ]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 2
        stdout: "spec/expect/list/partial-human.txt"
        stderr: "joplin$spare unavailable - results are incomplete\n"
        calls: [
          { instance:"joplin" method:"GET" path:"/notes" }
          { instance:"joplin$spare" method:"GET" path:"/notes" }
        ]
      }
    }

    {
      id: "list/strict-halts-the-fanout"
      args: ["list" "--strict" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [
          { instance:"joplin" account:"local" }
          { instance:"joplin$spare" account:"spare" net:offline:true }
        ]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 4
        stdout: "spec/expect/list/strict-halts.json"
        calls: [
          { instance:"joplin" method:"GET" path:"/notes" }
          { instance:"joplin$spare" method:"GET" path:"/notes" }
        ]
      }
    }

    {
      id: "list/odd-values-project-the-same-everywhere"
      # The awkward fixture: null, non-string and float values, keys out of order, markup and control characters. One rule per field.
      args: ["list" "--json"]
      ctx: {
        fixture: "joplin-odd"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
        stdout: "spec/expect/list/odd-values.json"
        calls: [{ instance:"joplin" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/odd-raw-is-the-canonical-writer"
      args: ["list" "--raw" "--json"]
      ctx: {
        fixture: "joplin-odd"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
        stdout: "spec/expect/list/odd-raw.json"
        calls: [{ instance:"joplin" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/case-folding-is-ascii-only"
      # `İ` does not fold to `i`. A port that used its language's lowercasing matched here.
      args: ["list" "title:istanbul" "--json"]
      ctx: {
        fixture: "joplin-odd"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 1
        stdout: "spec/expect/list/odd-no-match.json"
        calls: [{ instance:"joplin" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/case-folding-folds-ascii"
      args: ["list" "title:STRA" "--json"]
      ctx: {
        fixture: "joplin-odd"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 0
        stdout: "spec/expect/list/odd-strasse.json"
        calls: [{ instance:"joplin" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/no-full-case-folding"
      args: ["list" "title:STRASSE" "--json"]
      ctx: {
        fixture: "joplin-odd"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: {
        exit: 1
        stdout: "spec/expect/list/odd-no-match.json"
        calls: [{ instance:"joplin" method:"GET" path:"/notes" }]
      }
    }

    {
      id: "list/negation-after-a-term"
      # The same question asked in both orders, so both entries share one
      # expectation file: a port that parsed only one of them cannot pass.
      args: ["list" "title:e -title:limit" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
