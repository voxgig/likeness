primary: cli: {
  args: set: [
    {
      id: "args/dash-selector-refused-before-the-network"
      # A positional that begins with `-` is a flag unless it follows `--`.
      args: ["list" "-title:limit title:e" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
      }
      out: { exit:3 stdout:"spec/expect/args/dash-selector.json" calls: [] }
    }

    {
      id: "args/undeclared-flag-refused-before-the-network"
      # An undeclared flag was once read as a selector term, hiding rows.
      args: ["list" "--bogus" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
