      id: "doctor/unreachable"
      args: ["doctor" "--json"]
      ctx: {
        fixture: "joplin"
        connections: [{ instance:"joplin" account:"local" net:offline:true }]
        clock: "2026-09-18T00:00:00Z"
        seed: 1
