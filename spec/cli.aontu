        stdout: "spec/expect/secrets/needs-an-action.txt"
        stderr: "error: invalid-argument\n  `secrets` needs an action: get, grant, init, keys, list, remove, revoke, rotate or set\n  remedy  run `likeness help secrets` for what each does\n"
        calls: []
      }
