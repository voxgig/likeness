        files: "likeness.skmv": "fixtures/vault/likeness.skmv"
      }
      out: {
        exit: 3
        stdout: "spec/expect/secrets/value-is-never-an-argument.json"
        calls: []
        vault: {
          passphrase: "fixture master passphrase"
          names: ["joplin.apikey" "notion.apikey"]
          keys: [
            { key:"ci" master:false write:false grants: ["joplin.apikey"] }
            {
              key: "deploy"
              master: false
              write: true
              grants: ["joplin.apikey" "linear.apikey"]
            }
            { key:"master" master:true write:true grants: [] }
          ]
          values: {
            "joplin.apikey": "joplin-mock-token"
            "notion.apikey": "notion-fixture-token"
          }
        }
      }
    }

