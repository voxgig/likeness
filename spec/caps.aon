capability: linear: name: "linear"
capability: linear: entity: note: kind: "note"
capability: linear: entity: note: term: "issue"
capability: linear: entity: note: sdk: "issue"
# No remove operation exists, so a hard delete is refused from
# data rather than attempted. Linear archives instead.
capability: linear: entity: note: op: {
  list: true
  get: true
  search: "replica"
  create: true
  update: true
  move: "team-id"
  tag: false
  link: false
  archive: false
  delete: false
}
capability: linear: entity: space: kind: "space"
