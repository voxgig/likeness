capability: linear: entity: space: sdk: "team"
capability: linear: entity: space: op: {
  list: true
  get: true
  # The replica indexes NOTES only - note_fts is built over the note table -
  # so a space or a tag is not searchable through it either. Claiming
  # otherwise would be the same overclaim as the ones already corrected here.
  search: false
  create: false
  update: false
  move: false
  tag: false
  link: false
  archive: false
  delete: false
}
capability: linear: limit: {
  page_max: 100
  body: "markdown"
  search: "none"
  rate: 0
  version_token: false
}
