node_modules/
*.log
.DS_Store

# Scratch files written by the harness meta-tests, deleted in a finally.
spec/expect/.meta-*

# Compiled output. `make test-ts` builds it; nothing reads it from the tree.
typescript/dist/

# The dependency on the generated SDK is a `file:` path to a clone, so a lock
# here pins a directory on one machine rather than a revision. `make sdk` and
# spec/sources.aontu are what actually hold the SDKs still.
typescript/package-lock.json

# Parity comparison output, rebuilt by `make parity` on every run.
build/

# The Python port's pinned checkouts and virtual environment, which
# `make py-deps` builds, and what installing the port leaves beside it.
python/.deps/
python/.venv/
python/*.egg-info/
__pycache__/

# The Ruby port's dependencies, linked by `make rb-deps` to pinned checkouts.
ruby/vendor/

# The C port's objects, test programs and binary. `make test-c` builds them.
c/bin/
c/build/
